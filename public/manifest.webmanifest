{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Vet-Link",
  "short_name": "Vet-Link",
  "id": "/",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#3cb9b3",
  "theme_color": "#f8fafc",
  "icons": [
    {
      "src": "favicons/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "favicons/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicons/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "favicons/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}